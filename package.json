{
  "name": "tangazo",
  "productName": "TANGAZO",
  "version": "1.0.0",
  "description": "TANGAZO - Automated brand marketing department. Brand brain, campaign generation, content calendar and scheduled publishing for Instagram, Facebook, TikTok and LinkedIn.",
  "main": "main.js",
  "author": "Sam",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check.js",
    "smoke": "node tools/smoke.js",
    "e2e": "node tools/e2e.js",
    "test": "node tools/check.js && node tools/e2e.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sam.tangazo",
    "productName": "TANGAZO",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "TANGAZO-${version}.${ext}"
    }
  }
}

